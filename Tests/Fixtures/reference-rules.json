{
  "_comment": "Example rules in the original Python file-sorter format, used to test that such files import unchanged.",
  "auto_sort": false,
  "never_move": {
    "secret_extensions": [
      "pem",
      "key",
      "p12",
      "pfx",
      "ppk",
      "env",
      "kdbx",
      "ovpn",
      "keychain",
      "cer",
      "crt"
    ],
    "secret_name_contains": [
      "accesskey",
      "access_key",
      "password",
      "passwd",
      "secret",
      "credential",
      "token",
      "id_rsa",
      "id_ed25519",
      "ssh key",
      "recovery-code",
      "recovery_code",
      "private key"
    ],
    "skip_extensions": [
      "download",
      "crdownload",
      "part",
      "partial",
      "opdownload",
      "ini",
      "db",
      "torrent"
    ],
    "skip_name_prefixes": [
      "~$",
      "."
    ]
  },
  "folders": [
    {
      "name": "Desktop",
      "path": "~/Desktop",
      "age_field": "created",
      "enabled": true,
      "rules": [
        {
          "name": "Desktop rule 1",
          "enabled": true,
          "name_contains": [
            "Example"
          ],
          "extensions": [
            "mov",
            "mp4"
          ],
          "to": "~/Sorted/Desktop/1"
        },
        {
          "name": "Desktop rule 2",
          "enabled": true,
          "name_starts_with": [
            "PREFIX-"
          ],
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "heic",
            "gif",
            "webp"
          ],
          "to": "~/Sorted/Desktop/2"
        },
        {
          "name": "Desktop rule 3",
          "enabled": true,
          "name_contains": [
            "Example"
          ],
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "heic",
            "tiff",
            "gif",
            "pdf"
          ],
          "to": "~/Sorted/Desktop/3"
        }
      ]
    },
    {
      "name": "Downloads",
      "path": "~/Downloads",
      "age_field": "added",
      "enabled": true,
      "rules": [
        {
          "name": "Downloads rule 1",
          "enabled": true,
          "extensions": [
            "dmg",
            "img",
            "pkg"
          ],
          "to": "~/Sorted/Downloads/1"
        },
        {
          "name": "Downloads rule 2",
          "enabled": true,
          "extensions": [
            "app"
          ],
          "allow_bundles": true,
          "to": "~/Sorted/Downloads/2"
        },
        {
          "name": "Downloads rule 3",
          "enabled": true,
          "extensions": [
            "zip",
            "rar",
            "7z",
            "tar",
            "gz",
            "tgz",
            "bz2",
            "xz",
            "zst",
            "iso"
          ],
          "to": "~/Sorted/Downloads/3"
        },
        {
          "name": "Downloads rule 4",
          "enabled": true,
          "extensions": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "avi",
            "webm",
            "wmv",
            "flv",
            "mpg",
            "mpeg"
          ],
          "to": "~/Sorted/Downloads/4"
        },
        {
          "name": "Downloads rule 5",
          "enabled": true,
          "extensions": [
            "mp3",
            "m4a",
            "wav",
            "aac",
            "flac",
            "ogg",
            "aif",
            "aiff",
            "opus"
          ],
          "to": "~/Sorted/Downloads/5"
        },
        {
          "name": "Downloads rule 6",
          "enabled": true,
          "name_starts_with": [
            "PREFIX-"
          ],
          "extensions": [
            "jpg",
            "jpeg",
            "png",
            "gif",
            "webp",
            "heic"
          ],
          "to": "~/Sorted/Downloads/6"
        },
        {
          "name": "Downloads rule 7",
          "enabled": true,
          "extensions": [
            "jpg",
            "jpeg",
            "png",
            "gif",
            "webp",
            "heic",
            "heif",
            "tif",
            "tiff",
            "bmp",
            "svg",
            "psd",
            "dng",
            "cr2",
            "nef",
            "arw",
            "raw"
          ],
          "to": "~/Sorted/Downloads/7"
        },
        {
          "name": "Downloads rule 8",
          "enabled": true,
          "extensions": [
            "stl",
            "3mf",
            "blend",
            "obj"
          ],
          "to": "~/Sorted/Downloads/8"
        },
        {
          "name": "Downloads rule 9",
          "enabled": true,
          "extensions": [
            "pdf"
          ],
          "to": "~/Sorted/Downloads/9"
        },
        {
          "name": "Downloads rule 10",
          "enabled": true,
          "extensions": [
            "epub",
            "mobi",
            "azw3"
          ],
          "to": "~/Sorted/Downloads/10"
        },
        {
          "name": "Downloads rule 11",
          "enabled": true,
          "extensions": [
            "doc",
            "docx",
            "xls",
            "xlsx",
            "ppt",
            "pptx",
            "pages",
            "numbers",
            "odt",
            "ods",
            "odp",
            "rtf",
            "txt",
            "md",
            "csv",
            "tsv",
            "json",
            "xml",
            "html",
            "htm"
          ],
          "to": "~/Sorted/Downloads/11"
        },
        {
          "name": "Downloads rule 12",
          "enabled": true,
          "extensions": [
            "exe",
            "msi"
          ],
          "to": "~/Sorted/Downloads/12"
        },
        {
          "name": "Downloads rule 13",
          "enabled": true,
          "extensions": [
            "safetensors",
            "pt",
            "ckpt",
            "gguf"
          ],
          "to": "~/Sorted/Downloads/13"
        }
      ]
    }
  ]
}
